* text=auto eol=lf

# scripts must keep LF
*.sh text eol=lf

# binaries: never diff/merge as text
*.hbc binary
*.hdiff binary
*.bundle binary
*.jsbundle binary
*.png binary
*.jpg binary
*.keystore binary
*.a binary
*.apk binary
*.aab binary

# generated: collapsed in review UIs, excluded from language stats
schemas/fixtures/*.json linguist-generated=true
**/package-lock.json linguist-generated=true -diff
**/vectors/*.json linguist-generated=true
examples/*/dist/** linguist-generated=true

# Vendored third-party sources: keep upstream bytes (no line-ending normalization)
native/third_party/** -text
